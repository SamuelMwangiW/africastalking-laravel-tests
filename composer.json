{
    "name": "samuelmwangiw/africastalking-laravel-tests",
    "description": "Testing helpers for samuelmwangiw/africastalking-laravel: fake the Africa's Talking API and assert against Voice, SMS, Airtime, Mobile Data, SIM Swap, Payment, Stash, Wallet and Application calls.",
    "keywords": [
        "dev",
        "laravel",
        "africastalking-laravel",
        "africastalking-laravel-tests",
        "testing"
    ],
    "homepage": "https://github.com/samuelmwangiw/africastalking-laravel-tests",
    "license": "MIT",
    "authors": [
        {
            "name": "Samuel Mwangi",
            "email": "samuel@samuelmwangi.co.ke",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "saloonphp/laravel-plugin": "^4.0",
        "saloonphp/saloon": "^4.0",
        "samuelmwangiw/africastalking-laravel": "^3.0.0-alpha3"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.4",
        "larastan/larastan": "^3.0",
        "nunomaduro/collision": "^8.9.1",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "SamuelMwangiW\\Africastalking\\Testing\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SamuelMwangiW\\Africastalking\\Testing\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SamuelMwangiW\\Africastalking\\Testing\\AfricastalkingTestingServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
